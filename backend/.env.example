PROJECT_NAME="The Royal Knot — Wedding Planning Management System"
ENVIRONMENT=development

# Database Connection (PostgreSQL with psycopg)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/royal_knot_db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret Key
SECRET_KEY=replace-with-a-secure-random-secret-key

# Storage for registration documents and attachments
UPLOAD_DIR=uploads

# Agency Primary Email
AGENCY_EMAIL=saisubodh6@gmail.com

# Outgoing Email Configuration (Gmail SMTP)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=saisubodh6@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=saisubodh6@gmail.com
SMTP_USE_TLS=true

# Incoming Email Configuration (Gmail IMAP)
# Uses the same Gmail App Password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=saisubodh6@gmail.com
IMAP_PASSWORD=your_16_char_gmail_app_password
IMAP_USE_SSL=true
EMAIL_POLL_INTERVAL_SECONDS=60

# Frontend and Backend URLs
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# Activation Token Lifespan (in minutes: 72 hours = 4320)
ACTIVATION_TOKEN_EXPIRY_MINUTES=4320
