PROJECT_NAME="The Royal Knot — Wedding Planning Management System"
ENVIRONMENT=development

# Database Connection (PostgreSQL 18+ with psycopg)
# Local: postgresql+psycopg://postgres:your_password@localhost:5432/royal_knot_db
# Cloud: postgresql+psycopg://<user>:<password>@<cloud-host>:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/royal_knot_db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

