PROJECT_NAME="The Royal Knot — Wedding Planning Management System"
ENVIRONMENT=development

# Database Connection (PostgreSQL with psycopg)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/royal_knot_db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret Key
SECRET_KEY=theroyalknot-luxury-wedding-management-secret-key-2026

# Storage for registration documents, agreements, and attachments
UPLOAD_DIR=uploads

# Agency Primary Email
AGENCY_EMAIL=saisubodh6@gmail.com

# Outgoing Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=saisubodh6@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=saisubodh6@gmail.com
SMTP_USE_TLS=true

# Incoming Email Configuration (Gmail IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=saisubodh6@gmail.com
IMAP_PASSWORD=your_16_char_gmail_app_password
IMAP_USE_SSL=true
EMAIL_POLL_INTERVAL_SECONDS=60

# Frontend and Backend URLs
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# Activation Token Lifespan (in minutes: 72 hours = 4320)
ACTIVATION_TOKEN_EXPIRY_MINUTES=4320

# Electronic Signature Provider Configuration
# Options: zoho_sign (recommended default) or leegality
ESIGN_PROVIDER=zoho_sign

# Zoho Sign API Configuration (OAuth 2.0)
# Obtain credentials from Zoho API Console (https://api-console.zoho.in or https://api-console.zoho.com)
# Set ZOHO_SIGN_ENV=sandbox for official Zoho Sign sandbox, or mock for local simulation
ZOHO_SIGN_ENV=mock
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
ZOHO_SIGN_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_SIGN_API_BASE_URL=https://sign.zoho.in/api/v1
ZOHO_SIGN_REDIRECT_URI=http://localhost:8000/api/v1/auth/zoho/callback
ZOHO_SIGN_WEBHOOK_SECRET=
ZOHO_SIGN_TIMEOUT_SECONDS=30

# Zoho Sign Status Polling Configuration (Local verification without ngrok / public webhooks)
ZOHO_SIGN_POLLING_ENABLED=true
ZOHO_SIGN_POLLING_INTERVAL_SECONDS=60
ZOHO_SIGN_POLLING_MAX_RETRIES=5
ZOHO_SIGN_POLLING_TIMEOUT_SECONDS=30

# Historical Leegality Electronic Signature Configuration
# Kept for backward compatibility and historical record retrieval
LEEGALITY_ENV=sandbox
LEEGALITY_BASE_URL=https://sandbox.leegality.com/api/v2.1
LEEGALITY_AUTH_TOKEN=
LEEGALITY_PRIVATE_SALT=
LEEGALITY_API_VERSION=2.1
LEEGALITY_WEBHOOK_SUCCESS_URL=http://localhost:8000/api/v1/webhooks/leegality/success
LEEGALITY_WEBHOOK_FAILURE_URL=http://localhost:8000/api/v1/webhooks/leegality/failure
LEEGALITY_WEBHOOK_VERSION=1.0
LEEGALITY_TIMEOUT_SECONDS=30
LEEGALITY_ALLOWED_IPS=
