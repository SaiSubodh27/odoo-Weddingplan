PROJECT_NAME="The Royal Knot — Wedding Planning Management System"
ENVIRONMENT=development

# Database Connection (PostgreSQL with psycopg)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/royal_knot_db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret Key
SECRET_KEY=replace-with-a-secure-random-secret-key

# Storage for registration documents
UPLOAD_DIR=uploads

# SMTP Email Configuration (Optional in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=concierge@theroyalknot.in
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=concierge@theroyalknot.in
SMTP_USE_TLS=true

# Frontend and Backend URLs
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# Token Lifespan
ACTIVATION_TOKEN_EXPIRY_MINUTES=1440
